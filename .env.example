# ───────────────────────────────────────────────────────────────
#  ドット絵エディタ — ギャラリー用の環境変数（Vercel に設定する）
#  ※ 実際の値は絶対にコミットしないこと。リポジトリは公開設定です。
# ───────────────────────────────────────────────────────────────

# ── ギャラリーの合言葉 ──────────────────────────────────────────
# APP_PASSWORD     … ギャラリーの閲覧・投稿に必要な合言葉
# APP_AUTH_SECRET  … セッションCookieの署名鍵。次のコマンドで生成:
#                      openssl rand -hex 32
APP_PASSWORD=
APP_AUTH_SECRET=

# ── 保存先（Vercel Blob）───────────────────────────────────────
# Vercel のプロジェクトに Blob ストア（private）を接続すると自動で入ります。
#   npx vercel blob create-store dot-gallery --access private --yes
BLOB_READ_WRITE_TOKEN=
