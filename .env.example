# ───────────────────────────────────────────────────────────────
#  ドット絵エディタ — ギャラリー用の環境変数（Vercel に設定する）
#  ※ 実際の値は絶対にコミットしないこと。リポジトリは公開設定です。
# ───────────────────────────────────────────────────────────────

# ── ギャラリーの合言葉 ──────────────────────────────────────────
# APP_PASSWORD     … ギャラリーの閲覧・投稿に必要な合言葉
# APP_AUTH_SECRET  … セッションCookieの署名鍵。次のコマンドで生成:
#                      openssl rand -hex 32
APP_PASSWORD=
APP_AUTH_SECRET=

# ── 保存先（Upstash Redis / Vercel Marketplace から作成）─────────
# Vercel の Storage で Upstash for Redis を作ると自動で入ります。
# 手動で入れる場合は Upstash の REST URL とトークンを設定してください。
KV_REST_API_URL=
KV_REST_API_TOKEN=
